# Reuse the same Auth0 tenant domain as the existing SPA in
# ../auth0-login-flow (VITE_AUTH0_DOMAIN). Do not commit .env.

# Tenant domain from the Auth0 login-flow SPA (e.g. your-tenant.auth0.com)
AUTH0_DOMAIN=YOUR_AUTH0_APP_DOMAIN

# Regular Web Application (confidential) used by this agent backend.
# This is NOT the SPA Client ID — see SETUP_NEEDED.md.
AUTH0_CLIENT_ID=YOUR_AUTH0_APP_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_AUTH0_APP_CLIENT_SECRET

# API identifier the CIBA request asks the user to authorize.
AUTH0_AUDIENCE=https://veto-agent.example.com

# Auth0 user_id of the human who receives Guardian push / email to approve or veto.
# Example: auth0|aaaaaaaaaaaaaaaaaaaaaaaa
AUTH0_USER_ID=YOUR_AUTH0_USER_ID

# Auth0 refresh token from the signed-in user, used for Token Vault exchange.
AUTH0_REFRESH_TOKEN=YOUR_AUTH0_REFRESH_TOKEN

# Token Vault connection name for the third-party provider (Google by default).
AUTH0_CONNECTION=google-oauth2

# Set to true to run without dashboard credentials. Auth0 network calls are
# mocked and clearly labelled. Tests also use this mode.
AUTH0_DEMO_MODE=true

PORT=3847
