# Copy to .env and fill in credentials. Do not commit .env.
#
# Target for this challenge: Tiger Cloud service db-73589 (id xvtct51t58).
# Get a connection URI (password included only in your local shell):
#   tiger db uri --service-id xvtct51t58 --with-password
# Or copy the URI from the Tiger Cloud console (service overview).

TIGER_SERVICE_ID=xvtct51t58
TIGER_SERVICE_NAME=db-73589
PGHOST=xvtct51t58.drl2pcauup.tsdb.cloud.timescale.com
PGPORT=37499
PGUSER=tsdbadmin
PGPASSWORD=your-tsdbadmin-password
PGDATABASE=tsdb
PGSSLMODE=require
# Optional full URL (overrides the PG* parts when set):
# DATABASE_URL=postgresql://tsdbadmin:YOUR_PASSWORD@xvtct51t58.drl2pcauup.tsdb.cloud.timescale.com:37499/tsdb?sslmode=require

STREAMLIT_SERVER_PORT=8501
PRODUCER_INTERVAL_SEC=0.4
