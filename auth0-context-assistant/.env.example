# Auth0 tenant from the existing login-flow app.
AUTH0_DOMAIN=dev-6eodd480pubdklld.us.auth0.com
# SPA application (Universal Login). Fill in after creating or reusing an SPA in the dashboard.
AUTH0_CLIENT_ID=YOUR_SPA_CLIENT_ID
# First-party API identifier (audience) — create this API in the Auth0 dashboard.
AUTH0_AUDIENCE=https://mlh-ghw-context-assistant-api

# Custom API Client used by the backend for Token Vault access-token exchange.
# Leave blank until you complete the Token Vault steps in SETUP_NEEDED.md.
TOKEN_VAULT_CLIENT_ID=
TOKEN_VAULT_CLIENT_SECRET=
TOKEN_VAULT_CONNECTION=google-oauth2

# Server
PORT=3001
CLIENT_ORIGIN=http://localhost:5174

# Set to 1 to run without a live Auth0 login (local mock user + mock Token Vault).
# Clearly labelled in the UI. Use this for tests and screenshots when dashboard
# configuration is not finished.
AUTH_DEMO=0

# Vite (must be prefixed with VITE_)
VITE_AUTH0_DOMAIN=dev-6eodd480pubdklld.us.auth0.com
VITE_AUTH0_CLIENT_ID=YOUR_SPA_CLIENT_ID
VITE_AUTH0_AUDIENCE=https://mlh-ghw-context-assistant-api
VITE_API_BASE=http://localhost:3001
VITE_AUTH_DEMO=0
