# Copy to .env and fill in values. Never commit .env.
#
# Local OpenFGA (no credentials required):
#   ./bin/openfga run --playground-enabled=false --http-addr 127.0.0.1:8080 --grpc-addr 127.0.0.1:8081
#   npm run seed:fga
FGA_API_URL=http://127.0.0.1:8080
FGA_STORE_ID=
FGA_MODEL_ID=
# Leave FGA_AUTH_MODE=none for local OpenFGA.
# Use client_credentials for Auth0 FGA (https://dashboard.fga.dev).
FGA_AUTH_MODE=none
FGA_API_TOKEN_ISSUER=auth.fga.dev
FGA_API_AUDIENCE=https://api.us1.fga.dev/
FGA_CLIENT_ID=
FGA_CLIENT_SECRET=
# Port for the demo web UI
PORT=3456
